# Copy to .env for local development (npm run dev). On Vercel, set these under Project → Settings → Environment Variables.

# Claude (required)
ANTHROPIC_API_KEY=
# The Claude model ID, from https://platform.claude.com/docs/en/about-claude/models/overview
CLAUDE_MODEL=

# YouTube Data API v3 (recommended: real videos instead of search links)
YOUTUBE_API_KEY=

# Optional
# Only people with this code can build new courses
ACCESS_CODE=
# Requests per visitor in 10 minutes (a course is 3 requests)
RATE_LIMIT_PER_10_MIN=30
# "off" turns off the retry on a fallback model when Claude declines a request
CLAUDE_FALLBACKS=
